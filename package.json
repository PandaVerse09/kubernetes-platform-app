{
  "name": "kubernetes-platform-app",
  "version": "1.0.0",
  "description": "Production-grade Node.js REST API for Kubernetes Platform Engineering Lab",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "kubernetes",
    "platform-engineering",
    "gitops",
    "observability",
    "express",
    "prometheus"
  ],
  "author": "PandaVerse09",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
